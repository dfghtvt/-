<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮面板液态玻璃遮罩：深色渐变 + 顶部高光，模拟 iOS 26 液态玻璃 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#E61C1C1E"
        android:centerColor="#C01C1C1E"
        android:endColor="#D91C1C1E"
        android:angle="270" />
    <corners android:radius="24dp" />
</shape>
